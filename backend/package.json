{
  "name": "mis2601-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "migrate": "tsx src/db/migrate.ts up",
    "migrate:down": "tsx src/db/migrate.ts down",
    "migrate:status": "tsx src/db/migrate.ts status",
    "seed:masters": "tsx src/db/seeds/seed-masters.ts",
    "seed:foods": "tsx src/db/seeds/seed-foods.ts",
    "seed:demo": "tsx src/db/seeds/seed-demo-user.ts",
    "seed:thresholds": "tsx src/db/seeds/seed-food-group-thresholds.ts",
    "cron:hard-delete": "tsx src/modules/privacy/hardDeleteJob.ts",
    "gen:types": "tsx scripts/gen-types-from-openapi.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --dir tests/integration",
    "lint": "eslint . --ext .ts",
    "format": "prettier --write \"src/**/*.ts\""
  },
  "dependencies": {
    "bcrypt": "^5.1.1",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.0",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.10.0",
    "pino": "^9.3.0",
    "pino-http": "^10.2.0",
    "umzug": "^3.8.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.14.0",
    "@types/supertest": "^6.0.2",
    "@typescript-eslint/eslint-plugin": "^7.16.0",
    "@typescript-eslint/parser": "^7.16.0",
    "eslint": "^8.57.0",
    "openapi-typescript": "^7.3.0",
    "pino-pretty": "^11.2.0",
    "prettier": "^3.3.0",
    "supertest": "^7.0.0",
    "tsx": "^4.16.0",
    "typescript": "~5.5.0",
    "vitest": "^1.6.0"
  }
}
