# =============================================================================
# Backend (.env)  — 복사: cp .env.example backend/.env
# 포트/도메인 정책:
#   - Frontend dev:  9514
#   - Backend  dev:  9534
#   - 공개 도메인:   p14.sumzip.com  (Nginx 종단)
# =============================================================================

# Server
PORT=9534
NODE_ENV=development
# 로컬 dev + 프로덕션 도메인을 모두 허용
CORS_ORIGIN=http://localhost:9514,https://p14.sumzip.com

# Database (MariaDB 외부 호스트 — 실제 값은 .env에만)
# Intent-Plan.md: mis.iptime.org:13306
DB_HOST=mis.iptime.org
DB_PORT=13306
DB_USER=__FILL_ME__
DB_PASSWORD=__FILL_ME__
DB_NAME=__FILL_ME__
DB_POOL_LIMIT=10

# JWT (각각 32바이트 이상 무작위 문자열)
JWT_ACCESS_SECRET=__FILL_ME_RANDOM_32+__
JWT_REFRESH_SECRET=__FILL_ME_RANDOM_32+__
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# 민감 컬럼 암호화 (AES-256-GCM 마스터키, base64 32 bytes)
APP_ENCRYPTION_KEY=__FILL_ME_BASE64_32BYTES__

# LLM
# LLM_PROVIDER: openai | mock
LLM_PROVIDER=mock
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=__FILL_ME__
LLM_TIMEOUT_MS=25000
LLM_RETRIES=1

# Rate limit (recommendation)
REC_RATE_PER_HOUR=5
REC_RATE_PER_DAY=20

# Logging
LOG_LEVEL=info

# =============================================================================
# Frontend (frontend/.env.development)
# =============================================================================
# 로컬 개발 시 백엔드 dev 서버 직접 호출 (또는 Nginx 경유: https://p14.sumzip.com/api)
VITE_API_BASE=http://localhost:9534/api
VITE_PUBLIC_DOMAIN=p14.sumzip.com
